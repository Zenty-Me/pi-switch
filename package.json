{
  "name": "pi-switch",
  "version": "0.5.0",
  "description": "Pi Switch: a project workbench for Skills, MCP, shared rules and initialization presets",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zenty-Me/pi-switch.git"
  },
  "homepage": "https://github.com/Zenty-Me/pi-switch#readme",
  "bugs": { "url": "https://github.com/Zenty-Me/pi-switch/issues" },
  "keywords": ["pi-package", "pi-extension", "skills", "mcp", "presets"],
  "files": ["src", "README.md", "LICENSE", "CHANGELOG.md"],
  "pi": { "extensions": ["./src/index.ts"] },
  "engines": { "node": ">=22.19.0" },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.5.0 <2",
    "@earendil-works/pi-tui": ">=1.5.0 <2",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": { "optional": true },
    "@earendil-works/pi-tui": { "optional": true },
    "typebox": { "optional": true }
  },
  "devDependencies": { "@types/node": "^24.0.0", "typescript": "^5.9.3" },
  "scripts": {
    "test": "node --experimental-strip-types --test --test-isolation=none --test-reporter=spec test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "preview": "node --experimental-strip-types test/preview.mjs",
    "check": "npm run typecheck && npm test"
  }
}
